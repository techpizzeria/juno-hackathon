# Copy this file to `.env` and fill in your key (`make env` does the copy).
# The .env is bundled into the app at build time, so this key ships inside
# the binary. Fine for a hackathon demo, not for production.

# LLM provider for AI program creation: openai or anthropic.
LLM_PROVIDER=openai

# API key for the provider above. Leave blank to hide AI creation
# (manual program creation still works).
LLM_API_KEY=

# Optional model override. Defaults per provider: gpt-4o (openai),
# claude-opus-4-8 (anthropic).
LLM_MODEL=
